# Required: from Google Cloud Console (OAuth client, type "Desktop app")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. These are the defaults.
# Port 0 means "pick any free port". Use a fixed port if your Google client needs one.
GOOGLE_REDIRECT_URI=http://127.0.0.1:0/
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_PROFILE_URL=https://gmail.googleapis.com/gmail/v1/users/me/profile
# Scopes are separated by spaces.
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send
# Where accounts are saved. Default: ~/.config/aikido_email/accounts.json
# ACCOUNTS_FILE=
# Command that opens the browser.
BROWSER_CMD=xdg-open

# ---- Outlook / Office 365 (Microsoft Graph) ----
# Required: from Microsoft Entra > App registrations
# Redirect URI to register there: Web, http://localhost
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Optional. These are the defaults.
# "common" = work and personal accounts. Or use your tenant ID.
MS_TENANT=common
MS_REDIRECT_URI=http://localhost:0/
# MS_AUTH_URL=
# MS_TOKEN_URL=
MS_PROFILE_URL=https://graph.microsoft.com/v1.0/me
MS_SCOPES=offline_access User.Read Mail.Read Mail.Send
# MS_ACCOUNTS_FILE=

# ---- IMAP / SMTP (passwords are encrypted before they are saved) ----
# Required. Make a key with: openssl rand -base64 32
# If you lose or change this key, saved passwords cannot be read. Add the accounts again.
ACCOUNTS_KEY=
# IMAP_ACCOUNTS_FILE=

# ============================================================
# ---- Sending engine (run it with: cargo run -- serve) ----
# ============================================================
# Required. Postgres 16 or newer. Dev database: docker compose up -d
DATABASE_URL=postgres://aikido:aikido@127.0.0.1:55432/aikido

# Optional. These are the defaults.
# AIKIDO_BIND_ADDR=0.0.0.0:8080
# Base URL of this server. Needed for the web OAuth login (/v1/accounts/oauth/{provider}/start).
# Register <AIKIDO_PUBLIC_URL>/v1/accounts/oauth/gmail/callback (and .../microsoft/callback)
# as a redirect URI in the Google / Microsoft app. Use a "Web application" client for Google.
# AIKIDO_PUBLIC_URL=https://mail.example.com
# Where the auto-made encryption key and the first API keys are written (mode 600).
# AIKIDO_DATA_DIR=./data
# 32-byte key, base64. Make one with: openssl rand -base64 32
# If empty, a key is made once in <AIKIDO_DATA_DIR>/encryption.key. BACK THAT FILE UP.
# AIKIDO_ENCRYPTION_KEY=
# Set your own API keys for Docker / cloud deploys. If empty, the server makes them on
# first boot, prints them one time, and saves them in <AIKIDO_DATA_DIR>/initial_keys.txt.
# AIKIDO_ADMIN_API_KEY=
# AIKIDO_ACCOUNTS_API_KEY=
# AIKIDO_SENDING_API_KEY=
# AIKIDO_SCHEDULER_TICK_SECS=15
# AIKIDO_MAX_PARALLEL_ACCOUNTS=20
# true = log the emails, send nothing. Runs the whole engine with real timing.
# AIKIDO_DRY_RUN=false
# RUST_LOG=info

# ============================================================
# ---- Reply Check (reads the inboxes; read only) ----
# ============================================================
# Gmail needs the gmail.readonly scope, Microsoft needs Mail.Read (both are in the defaults above).
# See README.md: gmail.readonly is a "restricted" Google scope.
# AIKIDO_REPLIES_API_KEY=
# AIKIDO_REPLY_TICK_SECS=15
# AIKIDO_MAX_PARALLEL_SYNCS=10
# AIKIDO_MAX_MESSAGE_BYTES=10485760
# false = do not read any inbox
# AIKIDO_REPLY_CHECK_ENABLED=true

# ============================================================
# ---- Follow-ups (sequences of emails; stop on reply) ----
# ============================================================
# AIKIDO_FOLLOWUPS_API_KEY=
# false = this server copy makes no follow-up steps (the API still works)
# AIKIDO_FOLLOWUPS_ENABLED=true

# ============================================================
# ---- Leads (contacts, lists, CSV import and export) ----
# ============================================================
# AIKIDO_LEADS_API_KEY=
# AIKIDO_CAMPAIGNS_API_KEY=
# false = this server copy does not process CSV imports (the API still works)
# AIKIDO_LEADS_ENABLED=true

# ============================================================
# ---- Email Generator (AI text for the slots of a step) ----
# ============================================================
# Lead data is sent to the LLM provider you add (see README). Providers and their keys are added through the API.
# AIKIDO_GENERATOR_API_KEY=
# false = this server copy writes no AI text (the API still works; steps use their fallback text)
# AIKIDO_GENERATOR_ENABLED=true


# Web app login. The address people use in the browser (needed for OAuth, invite links and the login check).
# AIKIDO_PUBLIC_URL=https://mail.example.com
# Only on a trusted network without HTTPS:
# AIKIDO_INSECURE_COOKIES=false
# Only behind your own reverse proxy (the client IP is read from X-Forwarded-For):
# AIKIDO_TRUST_PROXY=false

# ---- Developer tools (Settings > Developer: live log, SQL console). Owner and admin only. false turns them off for everyone.
# AIKIDO_DEV_TOOLS=true

# ---- Open tracking (see docs/API.md section 26) ----
# The host that the CNAME of a tracking domain (media.yourdomain.com) must point to. Default: the host of AIKIDO_PUBLIC_URL.
# AIKIDO_TRACKING_CNAME_TARGET=app.example.com
# A public HTTPS listener for the tracking domains. With it the server gets and renews Let's Encrypt certificates itself.
# Use a port above 1024 in Docker (the image runs as a normal user) and map it: 443 -> 8443.
# AIKIDO_TRACKING_HTTPS_ADDR=0.0.0.0:8443
# Plain HTTP (Let's Encrypt checks a domain here, port 80 of the internet must reach it).
# AIKIDO_TRACKING_HTTP_ADDR=0.0.0.0:8081
# Let's Encrypt production is the default. For a first try use the staging directory:
# AIKIDO_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
# AIKIDO_ACME_EMAIL=you@example.com
# AIKIDO_TRACKING_ENABLED=true
# More address ranges that count as Apple Mail Privacy Protection (comma separated).
# AIKIDO_TRACKING_PROXY_CIDRS=
