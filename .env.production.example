# Settings for docker-compose.yml. Copy to .env (plain Docker) or paste into the Environment tab (Coolify).

# Required ---------------------------------------------------------------
# Letters and digits only (it goes into a web address). Make one: openssl rand -hex 24
POSTGRES_PASSWORD=
# The address people use in the browser. HTTPS. No slash at the end.
AIKIDO_PUBLIC_URL=https://mail.example.com
# Make one: openssl rand -base64 32
# BACK IT UP. If you lose it, the saved inbox passwords and tokens cannot be read.
AIKIDO_ENCRYPTION_KEY=

# Optional ---------------------------------------------------------------
# AIKIDO_TRUST_PROXY=true      (true behind Coolify or any reverse proxy)
# AIKIDO_DRY_RUN=false         (true = log emails, send nothing; good for a first try)
# RUST_LOG=info

# Connect Gmail / Outlook inboxes (register <AIKIDO_PUBLIC_URL>/v1/accounts/oauth/gmail/callback and .../microsoft/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT=common

# Your own API keys (else they are made on first boot; see /data/initial_keys.txt in the container)
# AIKIDO_ADMIN_API_KEY=
# AIKIDO_ACCOUNTS_API_KEY=
# AIKIDO_SENDING_API_KEY=
# AIKIDO_REPLIES_API_KEY=
# AIKIDO_FOLLOWUPS_API_KEY=
# AIKIDO_LEADS_API_KEY=
# AIKIDO_CAMPAIGNS_API_KEY=
# AIKIDO_GENERATOR_API_KEY=

# Engine speed and switches (set false on a second server copy to split the work)
# AIKIDO_SCHEDULER_TICK_SECS=15
# AIKIDO_MAX_PARALLEL_ACCOUNTS=20
# AIKIDO_REPLY_TICK_SECS=15
# AIKIDO_MAX_PARALLEL_SYNCS=10
# AIKIDO_MAX_MESSAGE_BYTES=10485760
# AIKIDO_REPLY_CHECK_ENABLED=true
# AIKIDO_FOLLOWUPS_ENABLED=true
# AIKIDO_LEADS_ENABLED=true
# AIKIDO_GENERATOR_ENABLED=true
