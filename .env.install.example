# Settings for the one-line installer. install.sh (Linux, macOS) or install.ps1 (Windows) makes ~/aikido-email/.env from this, with random values.
# Google and Microsoft keys do not go here: paste them in the app (Settings -> Environment).
POSTGRES_USER=aikido
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aikido
# The key that locks saved inbox passwords and tokens. Make one: openssl rand -base64 32
# BACK IT UP. If you lose it, saved inbox passwords cannot be read.
AIKIDO_ENCRYPTION_KEY=
# The port on your machine.
APP_PORT=8080
# The address you open in the browser. It must match APP_PORT.
AIKIDO_PUBLIC_URL=http://localhost:8080
# Lets the login work over plain HTTP. Trusted networks only. Remove it once you have HTTPS.
AIKIDO_INSECURE_COOKIES=true
